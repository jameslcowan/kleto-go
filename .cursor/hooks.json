{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": ".cursor/hooks/session-reinforce.sh",
        "timeout": 120
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/data-first-pre-tool.sh",
        "matcher": "Write"
      },
      {
        "command": ".cursor/hooks/allow-execution.sh"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/inject-context.sh",
        "matcher": "Write|Shell",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/shell-guard.sh"
      },
      {
        "command": ".cursor/hooks/allow-execution.sh"
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/after-file-edit.sh",
        "timeout": 30
      }
    ],
    "beforeMCPExecution": [
      {
        "command": ".cursor/hooks/allow-execution.sh"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/verify-stop.sh",
        "loop_limit": 10
      }
    ]
  }
}
